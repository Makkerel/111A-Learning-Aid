---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import "katex/dist/katex.min.css";
import "../styles/global.css";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const navLinks = [
  { href: "/", label: "Euler Angles" },
  { href: "/quaternions", label: "Quaternions" },
  { href: "/spacetime", label: "Applications" },
  { href: "/finite_groups", label: "Finite Groups SO(3)" },
];

const pageLabel =
  navLinks.find((link) => link.href === currentPath)?.label ??
  "MATH 111A Learning Aid";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageLabel} — MATH 111A Learning Aid</title>
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" preload />
    <ClientRouter />
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <p class="site-title">MATH 111A Learning Aid</p>
        <nav class="site-nav" aria-label="Topics">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class={currentPath === link.href ? "active" : ""}
            >
              {link.label}
            </a>
          ))}
        </nav>
      </header>

      <main class="prose" transition:animate="fade">
        <slot />
      </main>

      <footer class="site-footer">
        By Kevin Zhao, Jacky Wang, Patrick Cabigo, Winds, Clouds
      </footer>
    </div>
  </body>
</html>
