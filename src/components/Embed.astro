---
interface Props {
  src: string;
  caption: string;
  title?: string;
  aspectRatio?: string;
}

const {
  src,
  caption,
  title = 'Interactive embed',
  aspectRatio = '16 / 9',
} = Astro.props;
---

<figure class="embed-figure">
  <div class="embed-frame" style={`aspect-ratio: ${aspectRatio}`}>
    <iframe
      src={src}
      title={title}
      loading="lazy"
      allowfullscreen
    />
  </div>
  <figcaption class="embed-caption">{caption}</figcaption>
</figure>

<style>
  .embed-figure {
    margin: 1.75rem 0;
    border: 1px solid var(--border);
  }

  .embed-frame {
    position: relative;
    width: 100%;
  }

  .embed-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .embed-caption {
    margin: 0;
    padding: 0.7rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--muted);
    background: var(--surface);
    border-top: 1px solid var(--border);
  }
</style>
